# Copier en deploy/.env puis remplir. Ne jamais versionner ce fichier.
# Domaine qui pointe (enregistrement DNS A) vers l'adresse IP du serveur
DOMAIN=gestion.zegroupafrica.com
# Mots de passe longs et aléatoires : openssl rand -hex 24 (lettres et chiffres uniquement)
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# Phrase secrète des sauvegardes chiffrées (openssl rand -hex 32). À garder HORS du serveur :
# sans elle, les sauvegardes sont illisibles, y compris pour vous.
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=14

# Contact affiché quand l'essai est terminé (ex. « ZE GROUP au +228 90 00 00 00 »)
SUPPORT_CONTACT=
# Clé privée des licences du logiciel Windows : à recopier depuis le fichier confidentiel
# cle-privee-licences.txt. Ne jamais la publier ni la mettre dans le dépôt.
LICENSE_PRIVATE_KEY=

# Vente des licences en ligne (page /acheter-licence).
# Pour tester sans argent : PAYMENT_MODE=simulation. Pour encaisser pour de vrai : laisser PAYMENT_MODE vide
# et coller la clé API de votre compte marchand PayGate Global (https://paygateglobal.com).
# Dans le tableau de bord PayGate, URL de notification : https://VOTRE-DOMAINE/api/paiements/paygate
PAYMENT_MODE=
PAYGATE_API_KEY=

# Envoi des emails (codes de vérification à l'inscription, mot de passe oublié) depuis la boîte
# noreply@zegroupafrica.com hébergée chez LWS. Seul SMTP_PASSWORD est obligatoire : les autres valeurs
# ci-dessous sont celles par défaut. Sans SMTP_PASSWORD, pas de vérification d'email et le mot de passe
# oublié renvoie vers l'administrateur. Voir docs/DEPLOIEMENT.md, « Emails ».
SMTP_HOST=mail.zegroupafrica.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@zegroupafrica.com
SMTP_PASSWORD=
MAIL_FROM="ZE Gestion <noreply@zegroupafrica.com>"
