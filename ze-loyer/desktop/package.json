{
  "name": "ze-loyer-desktop",
  "productName": "ZE LOYER",
  "version": "1.0.0",
  "description": "ZE LOYER : la gestion locative, sur votre ordinateur",
  "author": "ZE GROUP",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "prepare-app": "node build/prepare.mjs",
    "start": "electron .",
    "smoke": "node build/smoke-test.cjs",
    "dist:win": "node build/prepare.mjs --target=win && electron-builder --win nsis --x64",
    "dist:linux": "node build/prepare.mjs --target=linux && electron-builder --linux dir"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.56.1"
  },
  "build": {
    "appId": "com.zegroup.zeloyer",
    "productName": "ZE LOYER",
    "copyright": "ZE GROUP",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "services.cjs",
      "splash.html",
      "icon.png",
      "package.json",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "app",
        "to": ".",
        "filter": [
          "server/**/*",
          "server/node_modules/**/*"
        ]
      },
      {
        "from": "app/drizzle",
        "to": "drizzle"
      },
      {
        "from": "app/pgsql",
        "to": "pgsql",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ZE LOYER",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "deleteAppDataOnUninstall": false,
      "artifactName": "ZE-LOYER-Installation-${version}.exe"
    },
    "linux": {
      "target": "dir",
      "icon": "icon.png"
    }
  }
}
