# Connexion PostgreSQL de l'application
DATABASE_URL=postgres://zl_owner:owner@localhost:5432/zeloyer
# URL publique (liens d'invitation, quittances)
APP_URL=http://localhost:3000
# Dossier des documents envoyés (contrats, preuves) en local
UPLOAD_DIR=./uploads
# Base de test (vidée par les tests d'intégration)
TEST_DATABASE_URL=postgres://zl_owner:owner@localhost:5432/zeloyer_test
# Secret de la tâche planifiée des rappels (GET /api/cron/rappels avec l'en-tête Authorization: Bearer <secret>)
CRON_SECRET=change-moi
# Canaux de notification externes : NON configurés par défaut (aucun email/SMS/WhatsApp n'est envoyé).
# EMAIL_PROVIDER=
# SMS_PROVIDER=
# WHATSAPP_PROVIDER=
