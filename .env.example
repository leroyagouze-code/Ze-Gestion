# Connexion applicative (rôle SANS bypass RLS)
DATABASE_URL=postgres://app_user:app_user_pwd@localhost:5432/gestion
# Connexion propriétaire (migrations uniquement)
DATABASE_ADMIN_URL=postgres://app_owner:owner@localhost:5432/gestion
APP_URL=http://localhost:3000
# Dossier des fichiers envoyés (logos, justificatifs) en local ; S3 en production
UPLOAD_DIR=./uploads
# Mot de passe du rôle app_user créé par la migration
APP_DB_PASSWORD=app_user_pwd
